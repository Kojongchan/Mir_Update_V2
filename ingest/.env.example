# Supabase 인제스트 설정 — 실제 값은 .env 로 복사하고 절대 커밋하지 말 것.
# service_role 키는 서버 전용 비밀. 브라우저/깃/채팅에 노출 금지.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY
MIR_RAW_BUCKET=raw
MIR_DERIVED_BUCKET=derived

# 선택: 변환 도구 경로 override (기본은 repo node_modules)
# FBX2GLTF_BIN=/path/to/FBX2glTF
# CONVERT2XKT=/path/to/convert2xkt.js

# APS(Forge) — ACC 파일을 우리 뷰어로 열기 (integration/aps). v1 앱 크리덴셜 재사용.
APS_CLIENT_ID=YOUR-APS-CLIENT-ID
APS_CLIENT_SECRET=YOUR-APS-CLIENT-SECRET
