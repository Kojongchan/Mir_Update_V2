# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Node / 프론트
node_modules/
dist/
build/
.vite/
*.log

# 변환 파이프라인 임시 산출물 (원본은 /data LFS, 산출물은 스토리지)
ingest/**/out/
ingest/**/tmp/
*.tmp

# PoC 파생 산출물 (poc/build.sh 로 재생성 — data/ 원본에서 변환)
poc/out/
poc/vendor/
poc/node_modules/

# OS / 에디터
.DS_Store
.idea/
.vscode/

# FBX2glTF 가 추출하는 텍스처 폴더 (변환 부산물)
data/*.fbm/

# 로컬 전용 three.js 격리 진단 도구 (vendor/three 의존 — 배포 안 함)
poc/_three.html
poc/out/*.xkt
poc/_xkttest.html

# 비밀 (Supabase 키 등)
.env
ingest/.env
